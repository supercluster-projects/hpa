  kubelet:\n    nodeIP:\n      validSubnets:\n        - 192.168.122.0/24\n\n  files:\n    - path: /etc/cri/conf.d/20-customization.part\n      op: create\n      content: |\n        [plugins.\"io.containerd.cri.v1.images\"]\n          discard_unpacked_layers = false\n\ncluster:\n  # Completely prevent Talos from deploying its native kube-proxy\n  # This enables pure eBPF routing via Cilium CNI (Kube-Proxy-Free mode)\n  proxy:\n    disabled: true\n  network:\n    cni:\n      name: none\n"],"docs":null,"examples":null,"id":"hpa-dev","kubernetes_version":"1.36.0","machine_configuration":"version: v1alpha1\ndebug: false\npersist: true\nmachine:\n    type: controlplane\n    token: va3qxm.qld8jv3vmismg9lt\n    ca:\n        crt: \n        key: LS0tLS1CRUdJTiBFRDI1NTE5IFBSSVZBVEUgS0VZLS0tLS0KTUM0Q0FRQXdCUVlESzJWd0JDSUVJSnVqcFVCbkNXajY4aDZpTkd0QzJRUjJPMG4xNitGamVlR1prOU16eFpJQgotLS0tLUVORCBFRDI1NTE5IFBSSVZBVEUgS0VZLS0tLS0K\n    certSANs: []\n    kubelet:\n        image: ghcr.io/siderolabs/kubelet:v1.36.0\n        defaultRuntimeSeccompProfileEnabled: true\n        nodeIP:\n            validSubnets:\n                - 192.168.122.0/24\n        disableManifestsDirectory: true\n    install:\n        disk: /dev/sda\n        image: ghcr.io/siderolabs/installer:v1.13.0\n        wipe: false\n        grubUseUKICmdline: true\n    files:\n        - content: |\n            [plugins.\"io.containerd.cri.v1.images\"]\n              discard_unpacked_layers = false\n          permissions: 0o0\n          path: /etc/cri/conf.d/20-customization.part\n          op: create\n    env:\n        http_proxy: http://192.168.122.1:10809\n        https_proxy: http://192.168.122.1:10809\n        no_proxy: 127.0.0.1,localhost,192.168.122.0/24,.cluster.local,hpa-node-cp-0,hpa-node-worker-0,hpa-node-worker-1,hpa-node-worker-2\n    time:\n        servers:\n            - 192.168.122.1\n    sysctls:\n        net.ipv4.conf.all.rp_filter: \"0\"\n        net.ipv4.conf.default.rp_filter: \"0\"\n    features:\n      