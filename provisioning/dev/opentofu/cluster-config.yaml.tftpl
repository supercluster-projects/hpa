# Talos machine configuration patches for the hpa-dev cluster
# Applied to both controlplane and worker machine configurations.
#
# These patches customize disk layout for the libvirt/bridge-based
# dev environment on hpa-bridge. Per-node networking (hostname, IP,
# bonding) is applied at the talos_machine_configuration_apply step.
#
# NOTE: IP addresses and network values are injected via Terraform's
# config_patches interpolation in main.tf using the network-variables.tf locals.
# This ensures DRY compliance with a single source of truth.
---
machine:
  sysctls:
    net.ipv4.conf.all.rp_filter: "0"
    net.ipv4.conf.default.rp_filter: "0"
    net.core/*: "0"
    net.ipv4.*: "0"
  env:
    # Proxy settings - values interpolated from Terraform locals
    # Proxy disabled to allow direct internet access for image pulls
    # http_proxy: "http://${gateway}:10809"
    # https_proxy: "http://${gateway}:10809"
    no_proxy: "127.0.0.1,localhost,${cidr_block},.cluster.local,${cp_node_names},${worker_node_names}"
  time:
    servers:
      - "${gateway}"

  # Spegel mirror configuration — enable for distributed image mirroring
  # This patch disables discard_unpacked_layers which is enabled by default
  # in Talos. Spegel requires layers to remain on disk for peer serving.
  features:
    kubePrism:
      enabled: true
      port: 7445

  kubelet:
    nodeIP:
      validSubnets:
        # CIDR block interpolated from Terraform locals
        - "${cidr_block}"

  files:
    - path: /etc/cri/conf.d/20-customization.part
      op: create
      content: |
        [plugins."io.containerd.grpc.v1.cri".containerd]
          discard_unpacked_layers = false

  # Optional offline bootstrap image registry mirrors for Talos v1.13+.
  # Keep this under machine:, not at the top level of the Talos config.
${offline_registry_enabled ? "  registries:\n    mirrors:\n      registry.k8s.io:\n        endpoints:\n          - \"${offline_registry}\"\n      ghcr.io:\n        endpoints:\n          - \"${offline_registry}\"\n      quay.io:\n        endpoints:\n          - \"${offline_registry}\"\n      docker.io:\n        endpoints:\n          - \"${offline_registry}\"\n" : ""}

cluster:
  # Completely prevent Talos from deploying its native kube-proxy
  # This enables pure eBPF routing via Cilium CNI (Kube-Proxy-Free mode)
  proxy:
    disabled: true
  network:
    cni:
      name: none