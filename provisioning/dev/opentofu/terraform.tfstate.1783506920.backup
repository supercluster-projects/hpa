LS0tLS1CRUdJTiBFRDI1NTE5IFBSSVZBVEUgS0VZLS0tLS0KTUM0Q0FRQXdCUVlESzJWd0JDSUVJTXFKWnBtV2lYT0E5cEF1RVdwTlVua1dvSllaRS9zRGN3RFh2UUttSEFpQQotLS0tLUVORCBFRDI1NTE5IFBSSVZBVEUgS0VZLS0tLS0K\n"},"sensitive_attributes":[[{"type":"get_attr","value":"client_configuration"},{"type":"get_attr","value":"client_key"}]]}]},{"mode":"data","type":"talos_machine_configuration","name":"controlplane","provider":"provider[\"registry.opentofu.org/siderolabs/talos\"]","instances":[{"schema_version":0,"attributes":{"cluster_endpoint":"https://192.168.122.100:6443","cluster_name":"hpa-dev","config_patches":["# Talos machine configuration patches for the hpa-dev cluster\n# Applied to both controlplane and worker machine configurations.\n#\n# These patches customize disk layout for the libvirt/bridge-based\n# dev environment on hpa-bridge. Per-node networking (hostname, IP,\n# bonding) is applied at the talos_machine_configuration_apply step.\n---\nmachine:\n  install:\n    # Install Talos to the first virtio disk (OS disk, /dev/vda in libvirt)\n    disk: /dev/vda\n    # Disable predictable network interface naming so interfaces appear as\n    # eth0/eth1 rather than enpXsY; required for consistent bond device naming\n    extraKernelArgs:\n      - net.ifnames=0\n    # UKI (Unified Kernel Image) conflicts with extraKernelArgs.\n    # Talos v1.13+ defaults to UKI. Explicitly disable for dev env.\n    grubUseUKICmdline: false\n  # Expose /dev/vdb as an unused raw block device for Ceph OSDs.\n  # Talos will not format or mount it; Ceph claims it directly.\n  disks:\n    - device: /dev/vdb\n# Spegel mirror configuration — enable for distributed image mirroring\n# Spegel provides OCI image mirroring between cluster nodes, reducing\n# registry pull load and improving node startup time.\n#\n# To enable:\n#   1. Uncomment the 'machine.files' block below\n#   2. Ensure SPEGEL_VERSION is set in .env (compatible with Talos v1.13+)\n#   3. Run provisioning/dev/scripts/install-spegel.sh\n#\n# This patch disables discard_unpacked_layers which is enabled by default\n# in Talos. Spegel requires layers to remain on disk for peer serving.\n#\n# machine:\n#   files:\n#     - path: /etc/cri/conf.d/20-customization.part\n#       op: create\n#       content: |\n#         [plugins.\"io.containerd.cri.v1.images\"]\n#           discard_unpacked_layers = false\n"],"docs":null,"examples":null,"id":"hpa-dev","kubernetes_version":"1.36.0","machine_configuration":"version: v1alpha1\ndebug: false\npersist: true\nmachine:\n    type: controlplane\n    token: p2g0d4.wbx6dptxdlbc9o85\n    ca:\n        crt: \n        key: LS0tLS1CRUdJTiBFRDI1NTE5IFBSSVZBVEUgS0VZLS0tLS0KTUM0Q0FRQXdCUVlESzJWd0JDSUVJQ1ZTdkFEaDVCYmVuMzFsbDRwUU1tUHgvL05yaWJwTnJoa2xya1VPUXBodAotLS0tLUVORCBFRDI1NTE5IFBSSVZBVEUgS0VZLS0tLS0K\n    certSANs: []\n    kubelet:\n        image: ghcr.io/siderolabs/kubelet:v1.36.0\n        defaultRuntimeSeccompProfileEnabled: true\n        disableManifestsDirectory: true\n    disks:\n        - device: /dev/vdb\n    install:\n        disk: /dev/vda\n        extraKernelArgs:\n            - net.ifnames=0\n        image: ghcr.io/siderolabs/installer:v1.13.0\n        wipe: false\n        grubUseUKICmdline: false\n    features:\n        diskQuotaSupport: true\n        kubePrism:\n            enabled: true\n            port: 7445\n        hostDNS:\n            enabled: true\n            forwardKubeDNSToHost: true\n    nodeLabels:\n        node.kubernetes.io/exclude-from-external-load-balancers: \"\"\ncluster:\n    id: XnjF7FStz96WjJICF49JapOxtXsDbaWN6FbBUcMN5O0=\n    secret: B96BMSrau9SgiRIMc0ehRIW6Xmo3LgjXpE0jIvuF0Gw=\n    controlPlane:\n        endpoint: https://192.168.122.100:6443\n    clusterName: hpa-dev\n    network:\n        dnsDomain: cluster.local\n        podSubnets:\n            - 10.244.0.0/16\n        serviceSubnets:\n            - 10.96.0.0/12\n    token: mf3o4r.l93qvzme5nl1a5kf\n    secretboxEncryptionSecret: /AgfsxyGI/he2LPT8npGRbJL/qcb/0mg7Pw6uXQwh0Q=\n    ca:\n        crt: \n        key: \n    aggregatorCA:\n        crt: \n        key: \n    serviceAccount:\n        key: \n    apiServer:\n        image: registry.k8s.io/kube-apiserver:v1.36.0\n        admissionControl:\n            - name: PodSecurity\n              configuration:\n                apiVersion: pod-security.admission.config.k8s.io/v1alpha1\n                defaults:\n                    audit: restricted\n                    audit-version: latest\n                    enforce: baseline\n                    enforce-version: latest\n                    warn: restricted\n                    warn-version: latest\n                exemptions:\n                    namespaces:\n                        - kube-system\n                    runtimeClasses: []\n                    usernames: []\n                kind: PodSecurityConfiguration\n        auditPolicy:\n            apiVersion: audit.k8s.io/v1\n            kind: Policy\n            rules:\n                - level: Metadata\n    controllerManager:\n        image: registry.k8s.io/kube-controller-manager:v1.36.0\n    proxy:\n        image: registry.k8s.io/kube-proxy:v1.36.0\n    scheduler:\n        image: registry.k8s.io/kube-scheduler:v1.36.0\n    discovery:\n        enabled: true\n        registries:\n            kubernetes:\n                disabled: true\n            service: {}\n    etcd:\n        ca:\n            crt: \n            key: \n---\napiVersion: v1alpha1\nkind: HostnameConfig\nauto: stable\n","machine_secrets":{"certs":{"etcd":{"cert":"","key":""},"k8s":{"cert":"","key":""},"k8s_aggregator":{"cert":"","key":""},"k8s_serviceaccount":{"key":""},"os":{"cert":"","key":"LS0tLS1CRUdJTiBFRDI1NTE5IFBSSVZBVEUgS0VZLS0tLS0KTUM0Q0FRQXdCUVlESzJWd0JDSUVJQ1ZTdkFEaDVCYmVuMzFsbDRwUU1tUHgvL05yaWJwTnJoa2xya1VPUXBodAotLS0tLUVORCBFRDI1NTE5IFBSSVZBVEUgS0VZLS0tLS0K"}},"cluster":{"id":"XnjF7FStz96WjJICF49JapOxtXsDbaWN6FbBUcMN5O0=","secret":"B96BMSrau9SgiRIMc0ehRIW6Xmo3LgjXpE0jIvuF0Gw="},"secrets":{"aescbc_encryption_secret":null,"bootstrap_tok