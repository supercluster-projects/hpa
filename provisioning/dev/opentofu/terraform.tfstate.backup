  kubelet:\n    nodeIP:\n      validSubnets:\n        - 192.168.122.0/24\n\n  files:\n    - path: /etc/cri/conf.d/20-customization.part\n      op: create\n      content: |\n        [plugins.\"io.containerd.cri.v1.images\"]\n          discard_unpacked_layers = false\n\ncluster:\n  # Completely prevent Talos from deploying its native kube-proxy\n  # This enables pure eBPF routing via Cilium CNI (Kube-Proxy-Free mode)\n  proxy:\n    disabled: true\n  network:\n    cni:\n      name: none\n"],"docs":null,"examples":null,"id":"hpa-dev","kubernetes_version":"1.36.0","machine_configuration":"version: v1alpha1\ndebug: false\npersist: true\nmachine:\n    type: controlplane\n    token: va3qxm.qld8jv3vmismg9lt\n    ca:\n        crt: \n        key: LS0tLS1CRUdJTiBFRDI1NTE5IFBSSVZBVEUgS0VZLS0tLS0KTUM0Q0FRQXdCUVlESzJWd0JDSUVJSnVqcFVCbkNXajY4aDZpTkd0QzJRUjJPMG4xNitGamVlR1prOU16eFpJQgotLS0tLUVORCBFRDI1NTE5IFBSSVZBVEUgS0VZLS0tLS0K\n    certSANs: []\n    kubelet:\n        image: ghcr.io/siderolabs/kubelet:v1.36.0\n        defaultRuntimeSeccompProfileEnabled: true\n        nodeIP:\n            validSubnets:\n                - 192.168.122.0/24\n        disableManifestsDirectory: true\n    install:\n        disk: /dev/sda\n        image: ghcr.io/siderolabs/installer:v1.13.0\n        wipe: false\n        grubUseUKICmdline: true\n    files:\n        - content: |\n            [plugins.\"io.containerd.cri.v1.images\"]\n              discard_unpacked_layers = false\n          permissions: 0o0\n          path: /etc/cri/conf.d/20-customization.part\n          op: create\n    env:\n        http_proxy: http://192.168.122.1:10809\n        https_proxy: http://192.168.122.1:10809\n        no_proxy: 127.0.0.1,localhost,192.168.122.0/24,.cluster.local,hpa-node-cp-0,hpa-node-worker-0,hpa-node-worker-1,hpa-node-worker-2\n    time:\n        servers:\n            - 192.168.122.1\n    sysctls:\n        net.ipv4.conf.all.rp_filter: \"0\"\n        net.ipv4.conf.default.rp_filter: \"0\"\n    features:\n        diskQuotaSupport: true\n        kubePrism:\n            enabled: true\n            port: 7445\n        hostDNS:\n            enabled: true\n            forwardKubeDNSToHost: true\n    nodeLabels:\n        node.kubernetes.io/exclude-from-external-load-balancers: \"\"\ncluster:\n    id: i4EmMTf6cKhXN5Y52gDTICBbOl5OfylJKAE8-tHiPak=\n    secret: MJsdPQRzv7ACn4i3Gs7Mkmn/76tNleRt9LmgQ0rLIvY=\n    controlPlane:\n        endpoint: https://192.168.122.100:6443\n    clusterName: hpa-dev\n    network:\n        cni:\n            name: none\n        dnsDomain: cluster.local\n        podSubnets:\n            - 10.244.0.0/16\n        serviceSubnets:\n            - 10.96.0.0/12\n    token: 1ags0d.5fr1dx3xwue1u7t6\n    secretboxEncryptionSecret: tWzX7TNa1bjNcoEaorvj6hF0noVYqnSXJpEZNUFa0Wk=\n    ca:\n        crt: \n        key: \n    aggregatorCA:\n        crt: \n        key: \n    serviceAccount:\n        key: \n    apiServer:\n        image: registry.k8s.io/kube-apiserver:v1.36.0\n        admissionControl:\n            - name: PodSecurity\n              configuration:\n                apiVersion: pod-security.admission.config.k8s.io/v1alpha1\n                defaults:\n                    audit: restricted\n                    audit-version: latest\n                    enforce: baseline\n                    enforce-version: latest\n                    warn: restricted\n                    warn-version: latest\n                exemptions:\n                    namespaces:\n                        - kube-system\n                    runtimeClasses: []\n                    usernames: []\n                kind: PodSecurityConfiguration\n        auditPolicy:\n            apiVersion: audit.k8s.io/v1\n            kind: Policy\n            rules:\n                - level: Metadata\n    controllerManager:\n        image: registry.k8s.io/kube-controller-manager:v1.36.0\n    proxy:\n        disabled: true\n        image: registry.k8s.io/kube-proxy:v1.36.0\n    scheduler:\n        image: regist